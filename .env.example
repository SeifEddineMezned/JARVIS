# ============================================================================
#  J.A.R.V.I.S. - AI keys
#  start.bat asks for your first key automatically. Add more here for more free requests: The more you add, the more free requests you get:
#  Jarvis chains them all and switches automatically when one runs out.
#  Leave unused lines empty. Never commit your real .env to GitHub!
# ============================================================================

# Google Gemini - best all-rounder (sees the screen best).  Free: ~20 req/day PER MODEL
#   -> https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Groq - super fast, most generous free tier (~1,000+ req/day)
#   -> https://console.groq.com/keys
GROQ_API_KEY=

# OpenRouter - dozens of free models, 50 req/day free (1,000/day after a one-time $10 top-up)
#   -> https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Mistral - free "Experiment" plan (phone verification), sees the screen too
#   -> https://console.mistral.ai/api-keys
MISTRAL_API_KEY=

# GitHub Models - free with any GitHub account (token needs the "models:read" permission)
#   -> https://github.com/settings/personal-access-tokens
GITHUB_TOKEN=

# ADVANCED (optional): local offline AI with Ollama (needs a strong PC).
# Install https://ollama.com, run:  ollama pull qwen3-vl:4b   then set:
# OLLAMA_MODEL=qwen3-vl:4b
# OLLAMA_VISION_MODEL=qwen3-vl:4b

# ---------------------------------------------------------------------------- optional
# JARVIS_PROVIDER_ORDER=gemini,groq,openrouter,mistral,github,ollama,custom
# GEMINI_MODEL=gemini-3.8-flash       # force a Gemini model (otherwise auto)
# GROQ_MODEL=openai/gpt-oss-120b      # override any provider's model: <PROVIDER>_MODEL
# Any other OpenAI-compatible API:
# CUSTOM_BASE_URL=https://api.example.com/v1
# CUSTOM_API_KEY=
# CUSTOM_MODEL=
# JARVIS_HONORIFIC=sir                # sir / ma'am / boss / your name
# JARVIS_VOICE=en-GB-RyanNeural       # any edge-tts voice
# JARVIS_PORT=8765
